datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model Veiculo {
  id        String   @id
  type      String   // BEV, PHEV ou EREV
  brand     String
  model     String
  battery   Float    // Capacidade da bateria em kWh
  maxAc     Float    // Potência máxima AC em kW
  maxDc     Float    // Potência máxima DC em kW
  range     Int      // Autonomia em km (ciclo PBEV / Inmetro)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("veiculos")
}

model SolicitacaoVeiculo {
  id          Int      @id @default(autoincrement())
  userName    String?  // Nome de quem solicitou
  userEmail   String?  // E-mail para contato
  brand       String   // Marca
  model       String   // Modelo / Versão
  type        String?  // BEV, PHEV ou EREV
  battery     Float?   // Bateria estimada em kWh
  sourceUrl   String?  // Link de referência ou ficha técnica
  notes       String?  // Observações do usuário
  status      String   @default("PENDENTE") // PENDENTE, APROVADA, REJEITADA
  adminNotes  String?  // Observações do administrador
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("solicitacoes_veiculos")
}
